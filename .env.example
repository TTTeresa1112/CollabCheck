# ===== CollabCheck 配置示例 =====
# 复制本文件为 .env 并填写真实值后即可使用：
#   cp .env.example .env

# 你的邮箱（必填）：NCBI / OpenAlex 等学术数据库 API 要求提供联系方式
USER_EMAIL=your_email@example.com

# NCBI E-utilities API Key（可选）
# 申请地址：https://www.ncbi.nlm.nih.gov/account/settings/
# 配置后 PubMed 请求限额从 3 次/秒提升到 10 次/秒
NCBI_API_KEY=

# Semantic Scholar API Key（可选）
# 申请地址：https://www.semanticscholar.org/product/api
# 配置后请求间隔从 3.1 秒缩短到 1.1 秒
S2_API_KEY=
